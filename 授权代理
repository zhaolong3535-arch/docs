4. 前端授权页面 public/authorize.html

```html
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>合约授权</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 640px; margin: 30px auto; padding: 0 16px; }
    input, button { padding: 8px; margin: 4px 0; }
    input { width: 100%; box-sizing: border-box; }
    button { cursor: pointer; }
    hr { margin: 24px 0; }
    .result { margin-top: 10px; color: #0b6; word-break: break-all; }
  </style>
</head>
<body>
  <h2>ERC20 授权</h2>

  <div>当前钱包：<span id="wallet">未连接</span></div>
  <button onclick="connectWallet()">连接 MetaMask</button>

  <hr />

  <label>被授权地址 spender</label>
  <input id="spender" placeholder="0x..." />

  <label>授权数量</label>
  <input id="amount" placeholder="整数，例如 100" />

  <button onclick="approve()">确认授权</button>
  <div id="txResult" class="result"></div>

  <script src="https://cdn.jsdelivr.net/npm/ethers@6.13.2/dist/ethers.umd.min.js"></script>
  <script>
    let provider, signer, userAddress, contractAddress;

    const ERC20_ABI = [
      'function approve(address spender, uint256 amount) returns (bool)'
    ];

    // 从 URL 读取参数
    const params = new URLSearchParams(location.search);
    const spenderFromUrl = params.get('spender') || '';
    const amountFromUrl = params.get('amount') || '';

    document.getElementById('spender').value = spenderFromUrl;
    document.getElementById('amount').value = amountFromUrl;

    async function loadConfig() {
      const r = await fetch('/api/config');
      const j = await r.json();
      if (j.ok) contractAddress = j.contractAddress;
    }
    loadConfig();

    async function connectWallet() {
      if (!window.ethereum) return alert('请安装 MetaMask');

      provider = new ethers.BrowserProvider(window.ethereum);
      await provider.send('eth_requestAccounts', []);

      signer = await provider.getSigner();
      userAddress = await signer.getAddress();

      document.getElementById('wallet').innerText = userAddress;
    }

    async function approve() {
      if (!signer) return alert('请先连接钱包');
      if (!contractAddress) return alert('合约地址未配置');

      const spender = document.getElementById('spender').value.trim();
      const amount = document.getElementById('amount').value.trim();

      if (!spender || !amount) return alert('填写 spender 和 amount');

      const c = new ethers.Contract(contractAddress, ERC20_ABI, signer);
      const tx = await c.approve(spender, amount);

      document.getElementById('txResult').innerText = '交易已发送：' + tx.hash;
      await tx.wait();
      document.getElementById('txResult').innerText += ' 已确认';
    }
  </script>
</body>
</html>
```

