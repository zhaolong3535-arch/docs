3. 后台页面 public/admin.html

```html
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>后台 - 生成授权链接</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 760px; margin: 30px auto; padding: 0 16px; }
    input, button { padding: 8px; margin: 4px 0; }
    input { width: 100%; box-sizing: border-box; }
    button { cursor: pointer; }
    hr { margin: 24px 0; }
    .result { margin-top: 10px; color: #0b6; word-break: break-all; }
  </style>
</head>
<body>
  <h2>后台登录</h2>
  <input id="username" placeholder="账号" value="zhaolong123" />
  <input id="password" type="password" placeholder="密码" />
  <button onclick="login()">登录</button>
  <span id="loginStatus"></span>

  <hr />

  <h2>生成前端授权链接</h2>
  <input id="spender" placeholder="被授权地址 spender，例如 0x..." />
  <input id="amount" placeholder="授权数量，整数，例如 100" />
  <button onclick="generateLink()">生成授权链接</button>
  <div id="linkResult" class="result"></div>

  <hr />

  <h2>查询 allowance</h2>
  <input id="owner" placeholder="owner 地址" />
  <input id="spenderQuery" placeholder="spender 地址" />
  <button onclick="queryAllowance()">查询</button>
  <div id="allowanceResult" class="result"></div>

  <script>
    let token = localStorage.getItem('token') || '';

    async function login() {
      const username = document.getElementById('username').value.trim();
      const password = document.getElementById('password').value;

      const r = await fetch('/api/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, password })
      });

      const j = await r.json();
      if (!j.ok) return alert(j.msg || '登录失败');

      token = j.token;
      localStorage.setItem('token', token);
      document.getElementById('loginStatus').innerText = '已登录';
    }

    function generateLink() {
      const spender = document.getElementById('spender').value.trim();
      const amount = document.getElementById('amount').value.trim();

      if (!spender || !amount) return alert('填写 spender 和 amount');

      const base = location.origin;
      const url = `${base}/authorize?spender=${encodeURIComponent(spender)}&amount=${encodeURIComponent(amount)}`;

      document.getElementById('linkResult').innerText = url;
      // 自动复制
      navigator.clipboard?.writeText(url);
      alert('授权链接已生成并复制到剪贴板');
    }

    async function queryAllowance() {
      const owner = document.getElementById('owner').value.trim();
      const spender = document.getElementById('spenderQuery').value.trim();

      if (!owner || !spender) return alert('填写 owner 和 spender');

      const r = await fetch(`/api/allowance?owner=${owner}&spender=${spender}`, {
        headers: { Authorization: 'Bearer ' + token }
      });

      const j = await r.json();
      if (!j.ok) return alert(j.msg || '查询失败');

      document.getElementById('allowanceResult').innerText = 'allowance: ' + j.allowance;
    }
  </script>
</body>
</html>
```

